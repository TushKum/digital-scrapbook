{
  "name": "NEERVANA — Patiala Water & Disease Surveillance",
  "short_name": "NEERVANA",
  "description": "Village-level water quality and water-borne disease early-warning for Patiala district. Officer command view, ASHA field dashboard, and public villager advisory.",
